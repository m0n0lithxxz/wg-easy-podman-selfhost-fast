# --- Required ----------------------------------------------------------------
# Public domain or IP that VPN clients connect to (also used for the TLS cert).
WG_HOST=your-domain.example.com

# --- Optional: defaults shown -------------------------------------------------
# WireGuard UDP port published on the host.
WG_PORT=51820
# Internal web UI port, proxied by Caddy.
WEB_UI_PORT=51821
# DNS servers handed to clients (Quad9).
DNS=9.9.9.9,149.112.112.112
# Client routing: full tunnel.
ALLOWED_IPS=0.0.0.0/0,::/0
# WireGuard tunnel subnets.
IPV4_CIDR=10.8.0.0/24
IPV6_CIDR=fd00:db8::/64
# Web UI admin username.
WG_USERNAME=admin
# Leave empty to generate a strong random password (stored in ~/.wg-easy/credentials).
WG_PASSWORD=
# Optional ACME email for Caddy.
ACME_EMAIL=
# Host paths for persistent config.
WG_CONFIG=/srv/wg-easy/config
CADDY_CONFIG=/srv/wg-easy/caddy

# --- Optional: torrent port-forwarding --------------------------------------
# Public port on the VPS forwarded (tcp+udp) to your torrent client.
# Leave empty to disable port forwarding.
TORRENT_PORT=
# WireGuard IP of the torrent client (read from the wg-easy Web UI).
# Required together with TORRENT_PORT.
TORRENT_CLIENT_IP=
